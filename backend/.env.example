APP_NAME="Multimodal RAG Knowledge Base"

# SQLite 数据库文件
SQLALCHEMY_DATABASE_URI="sqlite:///./app.db"

# Chroma 向量库持久化路径
CHROMA_PERSIST_DIR="./chroma_data"
MAIN_IMAGE_COLLECTION_NAME="images_main_kb"
COCO_PROPOSED_COLLECTION_NAME="images_coco_proposed"
DOC_COLLECTION_NAME="documents_text"

# 多模态模型（例如 Qwen-VL）OpenAI 风格接口
MLLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  # 示例，占位
MLLM_API_KEY="sk-1fce3abb190e45a29a15aadb4a67390e"
MLLM_MODEL_NAME="qwen3.5-plus"

# 文本 Embedding 模型（例如 BGE-m3 在线服务）
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_API_KEY="sk-1fce3abb190e45a29a15aadb4a67390e"
EMBEDDING_MODEL_NAME="qwen3-vl-embedding"

# LLM 生成模型
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_API_KEY="sk-1fce3abb190e45a29a15aadb4a67390e"
LLM_MODEL_NAME="qwen3.5-plus"

# P0 升级：重排序 / 图片快检索
RERANK_TOP_K=5
RERANK_CANDIDATE_K=20
IMAGE_FAST_RETRIEVAL_ENABLED=true
IMAGE_FAST_RETRIEVAL_CANDIDATE_K=8
IMAGE_GROUNDED_TEXT_AUGMENT_ENABLED=false
IMAGE_GROUNDED_TEXT_TOP_K=2
IMAGE_GROUNDED_MAX_IMAGES=2
IMAGE_GROUNDED_MAX_HISTORY_TURNS=2

APP_NAME="Multimodal RAG Knowledge Base"

# 后端 CORS
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://127.0.0.1:5173","http://127.0.0.1:5174","http://127.0.0.1:5175"]'

# SQLite 数据库文件
SQLALCHEMY_DATABASE_URI="sqlite:///./app.db"

# Chroma 向量库持久化路径
CHROMA_PERSIST_DIR="E:/BiShe/Code2/MyProject/backend/chroma_data"
MAIN_IMAGE_COLLECTION_NAME="images_main_kb"
COCO_PROPOSED_COLLECTION_NAME="images_coco_proposed"
DOC_COLLECTION_NAME="documents_text"
CHROMA_COLLECTION_NAME=""
PDF_TEXT_LOADER_BACKEND="pymupdf"
DISABLE_OUTBOUND_PROXY=true
DOC_PARSE_BACKEND="local"
MINERU_API_BASE_URL="https://mineru.net"
MINERU_API_TOKEN=""
MINERU_MODEL_VERSION="vlm"
MINERU_POLL_INTERVAL_SECONDS=2.0
MINERU_TIMEOUT_SECONDS=120

# 多模态模型（例如 Qwen-VL）OpenAI 风格接口
MLLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
MLLM_API_KEY="your-mllm-api-key"
MLLM_MODEL_NAME="qwen3.5-plus"
CHAT_COMPLETION_TIMEOUT_SECONDS=180
ENABLE_TIMING_LOGS=true
EXPOSE_TIMINGS_IN_API=false

# 文本 Embedding 模型（用于主流程向量检索）
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_MODEL_NAME="text-embedding-v4"

# 多模态 Embedding 模型（仅用于 CLIP baseline）
MULTIMODAL_EMBEDDING_API_KEY="your-multimodal-embedding-api-key"
MULTIMODAL_EMBEDDING_MODEL_NAME="qwen3-vl-embedding"

# PaddleOCR 所在 Python 环境（OCR baseline 子进程会优先尝试 PaddleOCR，失败后自动回退到 RapidOCR）
PADDLEOCR_PYTHON="E:/Pyenvironment/multimodal-rag/python.exe"

# LLM 生成模型
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL_NAME="qwen3.5-plus"

# 轻量任务文本模型（分类、查询改写、上下文压缩；留空则回退到 LLM_*）
TASK_LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
TASK_LLM_API_KEY="your-task-llm-api-key"
TASK_LLM_MODEL_NAME="qwen-flash"

# 查询重写
QUERY_REWRITE_ENABLED=true
QUERY_MULTI_QUERY_COUNT=3

# 重排序 / 图片检索
RERANK_MODEL_NAME="BAAI/bge-reranker-base"
RERANK_MODEL_PATH=""
RERANK_TOP_K=5
RERANK_CANDIDATE_K=20
IMAGE_FAST_RETRIEVAL_ENABLED=true
IMAGE_FAST_RETRIEVAL_CANDIDATE_K=8
IMAGE_GROUNDED_TEXT_AUGMENT_ENABLED=false
IMAGE_GROUNDED_TEXT_TOP_K=2
IMAGE_GROUNDED_MAX_IMAGES=2
IMAGE_GROUNDED_MAX_HISTORY_TURNS=2
SEARCH_DEFAULT_TOP_K=10
SEARCH_ENABLE_SCORE_FILTER=false
SEARCH_MIN_RELEVANCE_SCORE=0.0
CHAT_DEFAULT_TOP_K=5
CHAT_ENABLE_SCORE_FILTER=false
CHAT_MIN_RELEVANCE_SCORE=0.0

# 混合检索
BM25_INDEX_PATH="storage/bm25_index.pkl"
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# 上下文压缩 / 对话记忆
CONTEXT_COMPRESSION_ENABLED=true
CHAT_HISTORY_MAX_TURNS=5

# Agentic RAG
AGENTIC_RAG_ENABLED=false

# 评估模型
EVAL_BASE_URL=""
EVAL_API_KEY=""
EVAL_MODEL=""

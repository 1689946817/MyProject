APP_NAME="Multimodal RAG Knowledge Base"

# SQLite 数据库文件
SQLALCHEMY_DATABASE_URI="sqlite:///./app.db"

# Chroma 向量库持久化路径
CHROMA_PERSIST_DIR="./chroma_data"
CHROMA_COLLECTION_NAME="images_semantic_desc"

# 多模态模型（例如 Qwen-VL）OpenAI 风格接口
MLLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"  # 示例，占位
MLLM_API_KEY="YOUR_MLLM_API_KEY"
MLLM_MODEL_NAME="qwen-vl-max"

# 文本 Embedding 模型（例如 BGE-m3 在线服务）
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
EMBEDDING_API_KEY="YOUR_EMBEDDING_API_KEY"
EMBEDDING_MODEL_NAME="bge-m3"

# LLM 生成模型
LLM_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode"
LLM_API_KEY="YOUR_LLM_API_KEY"
LLM_MODEL_NAME="qwen-max"

